#!/usr/bin/env bash
# Builds the Backstage image, loads it into rancher-desktop, and deploys to k8s.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
IMAGE="backstage:local"
NAMESPACE="backstage"

cd "$REPO_ROOT"

log() { echo "==> $*"; }

# ── 1. Build ──────────────────────────────────────────────────────────────────
log "Building Docker image ($IMAGE) — this takes ~10 min on first run..."
docker build -t "$IMAGE" .

# ── 2. Load image into the container runtime visible to k8s ───────────────────
# kubeadm/containerd: images must be imported via ctr into the k8s.io namespace.
# rancher-desktop (containerd backend): load via rdctl shell + nerdctl.
# rancher-desktop (dockerd backend): Docker IS the CRI — no load needed.
CONTAINERD_SOCK="/run/containerd/containerd.sock"
K3S_SOCK="/run/k3s/containerd/containerd.sock"

if [ -S "$CONTAINERD_SOCK" ]; then
  log "kubeadm/containerd detected — importing image into k8s.io namespace..."
  docker save "$IMAGE" | sudo ctr --namespace k8s.io images import -
elif command -v rdctl &>/dev/null && rdctl shell -- test -S "$K3S_SOCK" 2>/dev/null; then
  log "rancher-desktop (containerd) detected — loading via nerdctl..."
  docker save "$IMAGE" | rdctl shell -- nerdctl --namespace k8s.io load
else
  log "dockerd CRI detected — docker image already visible to k8s (skipping load)."
fi

# ── 3. Optional: wire Grafana token ───────────────────────────────────────────
if ! kubectl get secret backstage-secrets -n "$NAMESPACE" &>/dev/null 2>&1; then
  log "Creating backstage-secrets (grafana-token empty by default)..."
  GRAFANA_PASS=$(kubectl get secret -n prometheus kube-prometheus-stack-grafana \
    -o jsonpath='{.data.admin-password}' 2>/dev/null | base64 -d || echo "")
  GRAFANA_TOKEN=""
  if [[ -n "$GRAFANA_PASS" ]]; then
    # Create a Grafana service-account token via the API
    log "Grafana admin password found — set GRAFANA_TOKEN manually if needed."
  fi
  kubectl create namespace "$NAMESPACE" --dry-run=client -o yaml | kubectl apply -f -
  kubectl create secret generic backstage-secrets \
    --namespace "$NAMESPACE" \
    --from-literal=github-token="${GITHUB_TOKEN:-}" \
    --from-literal=grafana-token="${GRAFANA_TOKEN:-}" \
    --dry-run=client -o yaml | kubectl apply -f -
fi

# ── 4. Apply manifests ────────────────────────────────────────────────────────
log "Applying k8s manifests..."
kubectl apply -k "$REPO_ROOT/k8s/"

# ── 5. Wait for rollout ───────────────────────────────────────────────────────
log "Waiting for rollout (up to 3 min)..."
kubectl rollout status deployment/backstage -n "$NAMESPACE" --timeout=180s

echo ""
echo "✅  Backstage  → http://localhost:30007"
echo "📊  Prometheus → http://localhost:30090"
echo "📈  Grafana    → http://localhost:31862   (admin / see below)"
echo ""
echo "Grafana admin password:"
kubectl get secret -n prometheus kube-prometheus-stack-grafana \
  -o jsonpath='{.data.admin-password}' | base64 -d && echo
