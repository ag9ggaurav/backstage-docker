{
  "name": "@backstage/plugin-scaffolder-backend",
  "version": "3.4.0",
  "description": "The Backstage backend plugin that helps you create new things",
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "scaffolder",
    "pluginPackages": [
      "@backstage/plugin-scaffolder",
      "@backstage/plugin-scaffolder-backend",
      "@backstage/plugin-scaffolder-common",
      "@backstage/plugin-scaffolder-node",
      "@backstage/plugin-scaffolder-node-test-utils",
      "@backstage/plugin-scaffolder-react"
    ],
    "peerModules": [
      "@backstage/plugin-catalog-backend-module-scaffolder-entity-model"
    ],
    "features": {
      ".": "@backstage/BackendFeature"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "backstage"
  ],
  "homepage": "https://backstage.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/backstage",
    "directory": "plugins/scaffolder-backend"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "backstage": "@backstage/BackendFeature",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.cjs.js"
    },
    "./alpha": {
      "require": "./dist/alpha.cjs.js",
      "types": "./dist/alpha.d.ts",
      "default": "./dist/alpha.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "alpha": [
        "dist/alpha.d.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "files": [
    "dist",
    "migrations",
    "config.d.ts",
    "assets"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "build:assets": "node scripts/build-nunjucks.js",
    "clean": "backstage-cli package clean",
    "generate": "backstage-repo-tools package schema openapi generate --server --client-package plugins/scaffolder-common",
    "lint": "backstage-cli package lint",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "start": "backstage-cli package start",
    "test": "backstage-cli package test"
  },
  "dependencies": {
    "@backstage/backend-openapi-utils": "^0.6.8",
    "@backstage/backend-plugin-api": "^1.9.0",
    "@backstage/catalog-model": "^1.8.0",
    "@backstage/config": "^1.3.7",
    "@backstage/errors": "^1.3.0",
    "@backstage/integration": "^2.0.1",
    "@backstage/plugin-catalog-node": "^2.2.0",
    "@backstage/plugin-events-node": "^0.4.21",
    "@backstage/plugin-permission-common": "^0.9.8",
    "@backstage/plugin-permission-node": "^0.10.12",
    "@backstage/plugin-scaffolder-common": "^2.1.0",
    "@backstage/plugin-scaffolder-node": "^0.13.2",
    "@backstage/types": "^1.2.2",
    "@types/luxon": "^3.0.0",
    "express": "^4.22.0",
    "fs-extra": "^11.2.0",
    "globby": "^11.0.0",
    "isbinaryfile": "^5.0.0",
    "isolated-vm": "^6.0.1",
    "jsonschema": "^1.5.0",
    "knex": "^3.0.0",
    "lodash": "^4.17.21",
    "logform": "^2.3.2",
    "luxon": "^3.0.0",
    "nunjucks": "^3.2.3",
    "p-queue": "^6.6.2",
    "prom-client": "^15.0.0",
    "triple-beam": "^1.4.1",
    "uuid": "^11.0.0",
    "winston": "^3.2.1",
    "winston-transport": "^4.7.0",
    "yaml": "^2.0.0",
    "zen-observable": "^0.10.0",
    "zod": "^3.25.76 || ^4.0.0",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@backstage/backend-defaults": "^0.17.0",
    "@backstage/backend-test-utils": "^1.11.2",
    "@backstage/cli": "^0.36.1",
    "@backstage/plugin-scaffolder-node-test-utils": "^0.3.10",
    "@backstage/repo-tools": "^0.17.1",
    "@types/express": "^4.17.6",
    "@types/fs-extra": "^11.0.0",
    "@types/nunjucks": "^3.1.4",
    "@types/supertest": "^2.0.8",
    "@types/zen-observable": "^0.8.0",
    "esbuild": "^0.27.0",
    "strip-ansi": "^7.1.0",
    "supertest": "^7.0.0",
    "wait-for-expect": "^4.0.0"
  },
  "configSchema": "config.d.ts"
}